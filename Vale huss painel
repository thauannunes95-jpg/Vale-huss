    }

    local function CreateTabBtn(name, page)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(0, 130, 0, 38)
        Btn.BackgroundColor3 = Theme.ButtonBG
        Btn.Text = name
        Btn.TextColor3 = Theme.TextMuted
        Btn.Font = Enum.Font.GothamMedium
        Btn.TextSize = 14
        Btn.Parent = TabContainer
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
        
        Btn.MouseButton1Click:Connect(function()
            for _, p in pairs(Pages) do p.Visible = false end
            page.Visible = true
            for _, b in pairs(TabContainer:GetChildren()) do
                if b:IsA("TextButton") then
                    Tween(b, "BackgroundColor3", Theme.ButtonBG, 0.2)
                    Tween(b, "TextColor3", Theme.TextMuted, 0.2)
                end
            end
            Tween(Btn, "BackgroundColor3", Theme.Accent, 0.2)
            Tween(Btn, "TextColor3", Theme.Text, 0.2)
        end)
    end

    CreateTabBtn("Hitbox", Pages.Hitbox)
    CreateTabBtn("Visuais", Pages.Visuals)
    CreateTabBtn("Player", Pages.Player)
    CreateTabBtn("Info", Pages.Info)

    local function CreateToggle(parent, text, stateVar, callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(0, 320, 0, 45)
        Btn.BackgroundColor3 = Theme.ButtonBG
        Btn.Text = "  " .. text
        Btn.TextColor3 = Theme.Text
        Btn.Font = Enum.Font.Gotham
        Btn.TextSize = 14
        Btn.TextXAlignment = Enum.TextXAlignment.Left
        Btn.Parent = parent
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
        
        local s = Instance.new("UIStroke", Btn)
        s.Color = stateVar and Theme.Accent or Theme.Border
        s.Thickness = 1

        local Status = Instance.new("TextLabel")
        Status.Size = UDim2.new(0, 50, 0, 20)
        Status.Position = UDim2.new(1, -60, 0.5, -10)
        Status.Text = stateVar and "ON" or "OFF"
        Status.TextColor3 = stateVar and Theme.Accent or Theme.TextMuted
        Status.Font = Enum.Font.GothamBold
        Status.TextSize = 12
        Status.BackgroundTransparency = 1
        Status.Parent = Btn

        Btn.MouseButton1Click:Connect(function()
            local newState = not Status.Text:find("ON")
            Status.Text = newState and "ON" or "OFF"
            Status.TextColor3 = newState and Theme.Accent or Theme.TextMuted
            s.Color = newState and Theme.Accent or Theme.Border
            callback(newState)
        end)
    end

    local function CreateSlider(parent, text, min, max, default, callback)
        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(0, 320, 0, 65)
        Frame.BackgroundTransparency = 1
        Frame.Parent = parent

        local Label = Instance.new("TextLabel")
        Label.Text = "  " .. text .. ": " .. default
        Label.Size = UDim2.new(1, 0, 0, 25)
        Label.TextColor3 = Theme.Text
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.BackgroundTransparency = 1
        Label.Parent = Frame

        local SliderBG = Instance.new("Frame")
        SliderBG.Size = UDim2.new(0, 300, 0, 6)
        SliderBG.Position = UDim2.new(0, 10, 0, 35)
        SliderBG.BackgroundColor3 = Theme.ButtonBG
        SliderBG.Parent = Frame
        Instance.new("UICorner", SliderBG)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        Fill.BackgroundColor3 = Theme.Accent
        Fill.Parent = SliderBG
        Instance.new("UICorner", Fill)

        local Input = Instance.new("TextButton")
        Input.Size = UDim2.new(1, 0, 1, 0)
        Input.BackgroundTransparency = 1
        Input.Text = ""
        Input.Parent = SliderBG

        Input.MouseButton1Down:Connect(function()
            local connection
            connection = UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
                    Fill.Size = UDim2.new(pos, 0, 1, 0)
                    local val = math.floor(min + (max - min) * pos)
                    Label.Text = "  " .. text .. ": " .. val
                    callback(val)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    connection:Disconnect()
                end
            end)
        end)
    end

    -- Populating Pages
    CreateToggle(Pages.Hitbox, "Minha Hitbox (Small)", getgenv().DZ_MyHitboxEnabled, function(v) getgenv().DZ_MyHitboxEnabled = v end)
    CreateSlider(Pages.Hitbox, "Tamanho Minha Hitbox", 0.1, 5, getgenv().DZ_MyHitbox, function(v) getgenv().DZ_MyHitbox = v end)
    
    CreateToggle(Pages.Hitbox, "Hitbox Inimigos (Big)", getgenv().DZ_EnemyHitboxEnabled, function(v) getgenv().DZ_EnemyHitboxEnabled = v end)
